@model ZEGU.WebApp.ViewModels.Requests.RequestsDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-speedometer2"></i> My Dashboard</h2>
        <p class="page-subtitle">Welcome back! Here is your maintenance request overview.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Request
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-list-ul me-2"></i>Total</p>
                    <h3 class="stat-value mb-0">@Model.TotalRequests</h3>
                </div>
                <i class="bi bi-list-ul stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-clock me-2"></i>Pending</p>
                    <h3 class="stat-value mb-0">@Model.PendingRequests</h3>
                </div>
                <i class="bi bi-clock stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-wrench me-2"></i>In Progress</p>
                    <h3 class="stat-value mb-0">@Model.InProgressRequests</h3>
                </div>
                <i class="bi bi-wrench stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-check-circle me-2"></i>Completed</p>
                    <h3 class="stat-value mb-0">@Model.CompletedRequests</h3>
                </div>
                <i class="bi bi-check-circle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <a asp-action="Create" class="btn btn-primary me-2">
            <i class="bi bi-plus-circle"></i> New Request
        </a>
        <a asp-action="MyRequests" class="btn btn-secondary">View All Requests</a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="bi bi-clock-history"></i> Recent Requests</h5>
                <a asp-action="MyRequests" class="btn btn-primary btn-sm">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th class="hide-mobile">Category</th>
                                    <th class="hide-mobile">Location</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th class="hide-mobile">Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td data-label="Request #"><strong>@request.RequestNumber</strong></td>
                                        <td data-label="Title" class="text-truncate-2">@request.Title</td>
                                        <td data-label="Category" class="hide-mobile">@request.Category.CategoryName</td>
                                        <td data-label="Location" class="hide-mobile">@request.Location.Building!.BuildingName - @request.Location.RoomNumber</td>
                                        <td data-label="Priority">
                                            <span class="badge priority-@request.Priority.ToString().ToLower()">@request.Priority</span>
                                        </td>
                                        <td data-label="Status">
                                            <span class="badge status-@request.Status.ToString().ToLower()">@request.Status</span>
                                        </td>
                                        <td data-label="Date" class="hide-mobile">@request.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td data-label="Actions">
                                            <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <h4>No requests yet</h4>
                        <p>You haven't submitted any maintenance requests yet.</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Submit Your First Request
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
