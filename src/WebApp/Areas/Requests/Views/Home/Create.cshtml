@model ZEGU.WebApp.ViewModels.Requests.CreateRequestViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "New Maintenance Request";
    var maxFileSizeMb = Configuration.GetValue<int>("Uploads:MaxFileSize", 5);
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-plus-circle"></i> New Maintenance Request</h2>
        <p class="page-subtitle">Fill in the details below to submit a maintenance request</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Create" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label required-field">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="Brief description of the problem" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required-field">Category</label>
                        <select asp-for="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.CategoryName</option>
                            }
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Building</label>
                            <select class="form-select" id="buildingSelect">
                                <option value="">-- Select Building --</option>
                                @foreach (var building in Model.Buildings)
                                {
                                    <option value="@building.Id" data-building="@building.Id" selected="@(Model.SelectedBuildingId == building.Id)">@building.BuildingName (@building.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label required-field">Room</label>
                            <select asp-for="LocationId" class="form-select" id="roomSelect" required disabled>
                                <option value="">-- Select Room --</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Asset (Optional)</label>
                        <select asp-for="AssetId" class="form-select" id="assetSelect" disabled>
                            <option value="">-- Select Room First --</option>
                        </select>
                        <small class="text-muted">If this issue relates to a specific registered item (e.g. a computer or air conditioner), select it here.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Department (Optional)</label>
                        <select asp-for="DepartmentId" class="form-select">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in Model.Departments)
                            {
                                <option value="@dept.Id">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required-field">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the problem in detail"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted"><i class="bi bi-info-circle"></i> Priority is determined automatically from the category and details you provide, and can be reviewed by our Works team after submission.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Photos / Documents (Optional)</label>
                        <input asp-for="Photos" id="photosInput" type="file" class="form-control" accept="image/*,.pdf,.doc,.docx" multiple />
                        <small class="text-muted">You can upload multiple photos or documents (PDF, DOC, DOCX), max @maxFileSizeMb MB each</small>
                        <div id="fileSizeError" class="text-danger small mt-1" style="display:none;"></div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> Submit Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const maxFileSizeBytes = @maxFileSizeMb * 1024 * 1024;

        document.getElementById('photosInput').addEventListener('change', function() {
            const errorDiv = document.getElementById('fileSizeError');
            const oversized = Array.from(this.files).filter(f => f.size > maxFileSizeBytes);

            if (oversized.length > 0) {
                errorDiv.textContent = `${oversized.map(f => f.name).join(', ')} exceed${oversized.length === 1 ? 's' : ''} the @maxFileSizeMb MB limit and will not be uploaded. Please remove and re-select your files.`;
                errorDiv.style.display = 'block';
                this.value = '';
            } else {
                errorDiv.style.display = 'none';
            }
        });

        function resetAssetSelect() {
            const assetSelect = document.getElementById('assetSelect');
            assetSelect.disabled = true;
            assetSelect.innerHTML = '<option value="">-- Select Room First --</option>';
        }

        function loadRooms(buildingId, selectRoomId, selectAssetIdAfter) {
            const roomSelect = document.getElementById('roomSelect');

            if (!buildingId) {
                roomSelect.disabled = true;
                roomSelect.innerHTML = '<option value="">-- Select Room --</option>';
                resetAssetSelect();
                return;
            }

            roomSelect.disabled = false;
            roomSelect.innerHTML = '<option value="">-- Select Room --</option>';

            return fetch(`/api/locations/rooms?buildingId=${buildingId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.length === 0) {
                        const option = document.createElement('option');
                        option.value = "";
                        option.textContent = "No rooms available";
                        roomSelect.appendChild(option);
                    } else {
                        data.forEach(room => {
                            const option = document.createElement('option');
                            option.value = room.id;
                            option.textContent = `${room.roomNumber} (${room.roomType || 'Room'})`;
                            roomSelect.appendChild(option);
                        });
                    }
                    if (selectRoomId) {
                        roomSelect.value = selectRoomId;
                        return loadAssets(selectRoomId, selectAssetIdAfter);
                    }
                })
                .catch(error => {
                    console.error('Error loading rooms:', error);
                    const option = document.createElement('option');
                    option.value = "";
                    option.textContent = "Error loading rooms";
                    roomSelect.appendChild(option);
                });
        }

        function loadAssets(locationId, selectAssetId) {
            const assetSelect = document.getElementById('assetSelect');

            if (!locationId) {
                resetAssetSelect();
                return;
            }

            assetSelect.disabled = false;
            assetSelect.innerHTML = '<option value="">-- None --</option>';

            return fetch(`/api/locations/assets?locationId=${locationId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.length === 0) {
                        const option = document.createElement('option');
                        option.value = "";
                        option.textContent = "No registered assets at this location";
                        assetSelect.appendChild(option);
                    } else {
                        data.forEach(asset => {
                            const option = document.createElement('option');
                            option.value = asset.id;
                            option.textContent = asset.assetCode ? `${asset.assetName} (${asset.assetCode})` : asset.assetName;
                            assetSelect.appendChild(option);
                        });
                    }
                    if (selectAssetId) {
                        assetSelect.value = selectAssetId;
                    }
                })
                .catch(error => {
                    console.error('Error loading assets:', error);
                    assetSelect.innerHTML = '<option value="">-- None --</option>';
                });
        }

        document.getElementById('buildingSelect').addEventListener('change', function() {
            loadRooms(this.value, null, null);
        });

        document.getElementById('roomSelect').addEventListener('change', function() {
            loadAssets(this.value, null);
        });

        @if (Model.SelectedBuildingId > 0)
        {
            <text>
        document.getElementById('buildingSelect').value = '@Model.SelectedBuildingId';
        loadRooms('@Model.SelectedBuildingId', '@Model.LocationId', '@Model.AssetId');
            </text>
        }
    </script>
}
