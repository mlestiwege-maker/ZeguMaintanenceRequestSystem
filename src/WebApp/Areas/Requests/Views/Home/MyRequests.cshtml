@model List<ZEGU.Core.Entities.Maintenance.MaintenanceRequest>

@{
    ViewData["Title"] = "My Requests";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-list-check"></i> My Maintenance Requests</h2>
        <p class="page-subtitle">Track and manage all your maintenance requests</p>
    </div>
    <a asp-area="Requests" asp-controller="Home" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Request
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            <tr>
                                <td><strong>@request.RequestNumber</strong></td>
                                <td>@request.Title</td>
                                <td>@request.Category.CategoryName</td>
                                <td>@request.Location.Building.BuildingName - @request.Location.RoomNumber</td>
                                <td>
                                    <span class="badge priority-@request.Priority.ToString().ToLower()">@request.Priority</span>
                                </td>
                                <td>
                                    <span class="badge status-@request.Status.ToString().ToLower()">@request.Status</span>
                                </td>
                                <td>@request.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="table-actions">
                                    <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (request.Status == ZEGU.Core.Enums.MaintenanceRequestStatus.Submitted || request.Status == ZEGU.Core.Enums.MaintenanceRequestStatus.Assigned)
                                    {
                                        <form method="post" asp-action="Cancel" asp-route-requestId="@request.Id" style="display: inline;" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Cancel Request">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <h4>No requests found</h4>
                <p>You haven't submitted any maintenance requests yet.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Submit Your First Request
                </a>
            </div>
        </div>
    </div>
}
