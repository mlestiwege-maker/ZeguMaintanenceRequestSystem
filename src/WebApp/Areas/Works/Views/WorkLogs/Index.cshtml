@model List<ZEGU.Core.Entities.Maintenance.WorkLog>

@{
    ViewData["Title"] = "Work Logs";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-journal-text"></i> Work Logs</h2>
        <p class="page-subtitle">Request #@ViewBag.RequestId</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-requestId="@ViewBag.RequestId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Work Log
        </a>
        <a asp-action="Details" asp-controller="Home" asp-route-id="@ViewBag.RequestId" class="btn btn-secondary">Back to Request</a>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Technician</th>
                            <th>Work Performed</th>
                            <th>Hours Spent</th>
                            <th>Started</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(log.Technician?.User?.FirstName ?? "N/A") @(log.Technician?.User?.LastName ?? "")</td>
                                <td>@log.WorkPerformed</td>
                                <td>@log.HoursSpent</td>
                                <td>@(log.StartedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td>@(log.CompletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="empty-state">
                <i class="bi bi-journal-x"></i>
                <h4>No work logs yet</h4>
                <p>No work logs have been recorded for this request.</p>
                <a asp-action="Create" asp-route-requestId="@ViewBag.RequestId" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add First Work Log
                </a>
            </div>
        </div>
    </div>
}
