@model List<ZEGU.Core.Entities.Maintenance.MaterialRequest>
@{
    ViewData["Title"] = "Material Requests";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-box-seam"></i> Material Requests</h2>
        <p class="page-subtitle">Requests from technicians for materials needed on a job</p>
    </div>
</div>

<div class="filter-bar mb-3">
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(ViewBag.SelectedStatus == "Pending" ? "btn-primary" : "btn-outline-primary")">Pending</a>
        <a asp-action="Index" asp-route-status="Approved" class="btn btn-sm @(ViewBag.SelectedStatus == "Approved" ? "btn-primary" : "btn-outline-primary")">Approved</a>
        <a asp-action="Index" asp-route-status="Rejected" class="btn btn-sm @(ViewBag.SelectedStatus == "Rejected" ? "btn-primary" : "btn-outline-primary")">Rejected</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Technician</th>
                            <th>Material</th>
                            <th>Quantity</th>
                            <th class="hide-mobile">Notes</th>
                            <th>Requested</th>
                            @if (ViewBag.SelectedStatus == "Pending")
                            {
                                <th>Actions</th>
                            }
                            else
                            {
                                <th>Status</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mr in Model)
                        {
                            <tr>
                                <td data-label="Request #">
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@mr.RequestId">@mr.Request.RequestNumber</a>
                                </td>
                                <td data-label="Technician">@(mr.Technician.User != null ? $"{mr.Technician.User.FirstName} {mr.Technician.User.LastName}" : "Unassigned")</td>
                                <td data-label="Material">@mr.Material.MaterialName</td>
                                <td data-label="Quantity">@mr.QuantityRequested @mr.Material.Unit <small class="text-muted">(@mr.Material.CurrentStock in stock)</small></td>
                                <td data-label="Notes" class="hide-mobile">@mr.Notes</td>
                                <td data-label="Requested">@mr.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                @if (mr.Status == ZEGU.Core.Enums.MaterialRequestStatus.Pending)
                                {
                                    <td data-label="Actions">
                                        <form method="post" asp-action="Approve" asp-route-id="@mr.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="collapse" data-bs-target="#reject-@mr.Id" title="Reject">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                        <div class="collapse mt-2" id="reject-@mr.Id">
                                            <form method="post" asp-action="Reject" asp-route-id="@mr.Id" class="d-flex gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="text" name="reviewNotes" class="form-control form-control-sm" placeholder="Reason" required />
                                                <button type="submit" class="btn btn-sm btn-danger">Confirm</button>
                                            </form>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    var statusClass = mr.Status == ZEGU.Core.Enums.MaterialRequestStatus.Approved ? "bg-success" : "bg-danger";
                                    <td data-label="Status">
                                        <span class="badge @statusClass">@mr.Status</span>
                                        @if (!string.IsNullOrEmpty(mr.ReviewNotes))
                                        {
                                            <br /><small class="text-muted">@mr.ReviewNotes</small>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-box-seam"></i>
                <h4>No @(ViewBag.SelectedStatus.ToString().ToLower()) material requests</h4>
                <p>Requests from technicians will show up here.</p>
            </div>
        }
    </div>
</div>
