@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-speedometer2"></i> Works Dashboard</h2>
        <p class="page-subtitle">Maintenance operations overview</p>
    </div>
    <a asp-action="AllRequests" class="btn btn-primary">
        <i class="bi bi-list-check"></i> All Requests
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-list-ul me-2"></i>Total</p>
                    <h3 class="stat-value mb-0">@Model.TotalRequests</h3>
                </div>
                <i class="bi bi-list-ul stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-clock me-2"></i>Pending</p>
                    <h3 class="stat-value mb-0">@Model.PendingRequests</h3>
                </div>
                <i class="bi bi-clock stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-wrench me-2"></i>In Progress</p>
                    <h3 class="stat-value mb-0">@Model.InProgressRequests</h3>
                </div>
                <i class="bi bi-wrench stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-check-circle me-2"></i>Completed</p>
                    <h3 class="stat-value mb-0">@Model.CompletedRequests</h3>
                </div>
                <i class="bi bi-check-circle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-danger text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-exclamation-triangle me-2"></i>Emergency</p>
                    <h3 class="stat-value mb-0">@Model.EmergencyRequests</h3>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5><i class="bi bi-clock-history"></i> Recent Requests</h5>
                <a asp-action="AllRequests" class="btn btn-primary btn-sm">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-mobile-cards">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Requester</th>
                                <th class="hide-mobile">Category</th>
                                <th class="hide-mobile">Location</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th class="hide-mobile">Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.RecentRequests)
                            {
                                <tr>
                                    <td data-label="Request #">@request.RequestNumber</td>
                                    <td data-label="Requester">@request.User.FirstName @request.User.LastName</td>
                                    <td data-label="Category" class="hide-mobile">@request.Category.CategoryName</td>
                                    <td data-label="Location" class="hide-mobile">@request.Location.Building!.BuildingName - @request.Location.RoomNumber</td>
                                    <td data-label="Priority">
                                        <span class="badge priority-@request.Priority.ToString().ToLower()">@request.Priority</span>
                                    </td>
                                    <td data-label="Status">
                                        <span class="badge status-@request.Status.ToString().ToLower()">@request.Status</span>
                                    </td>
                                    <td data-label="Date" class="hide-mobile">@request.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td data-label="Actions" class="table-actions">
                                        <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
