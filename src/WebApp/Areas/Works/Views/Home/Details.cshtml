@model ZEGU.Core.Entities.Maintenance.MaintenanceRequest

@{
    ViewData["Title"] = $"Request {Model.RequestNumber} Details";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-file-earmark-text"></i> Request @Model.RequestNumber</h2>
        <p class="page-subtitle">Request details, history, and actions</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AllRequests" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
        @if (Model.Status == ZEGU.Core.Enums.MaintenanceRequestStatus.Submitted)
        {
            <a asp-action="AssignTechnician" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Assign Technician
            </a>
            <a asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="bi bi-x-circle"></i> Reject
            </a>
        }
        <a asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-arrow-repeat"></i> Update Status
        </a>
        <a asp-action="UpdatePriority" asp-route-id="@Model.Id" class="btn btn-secondary">
            <i class="bi bi-arrow-up-circle"></i> Update Priority
        </a>
        <a asp-action="Index" asp-controller="WorkLogs" asp-route-requestId="@Model.Id" class="btn btn-info">
            <i class="bi bi-journal-text"></i> Work Logs
        </a>
    </div>
</div>

@if (Model.Status == ZEGU.Core.Enums.MaintenanceRequestStatus.Completed && (User.IsInRole(nameof(ZEGU.Core.Enums.UserRole.Manager)) || User.IsInRole(nameof(ZEGU.Core.Enums.UserRole.Admin))))
{
    <div class="card mb-3 border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-check2-circle"></i> Awaiting Your Final Approval</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">The assigned technician has marked this request complete. Review the work below and give the final decision.</p>
            <div class="d-flex flex-wrap gap-2">
                <form method="post" asp-action="ApproveCompletion" asp-route-id="@Model.Id" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Approve &amp; Verify
                    </button>
                </form>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#sendBackForm">
                    <i class="bi bi-arrow-counterclockwise"></i> Send Back for Rework
                </button>
            </div>
            <div class="collapse mt-3" id="sendBackForm">
                <form method="post" asp-action="SendBackForRework" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label small">Reason (visible to the technician)</label>
                        <textarea name="reason" class="form-control form-control-sm" rows="2" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-arrow-counterclockwise"></i> Send Back
                    </button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5><i class="bi bi-info-circle"></i> Request Details</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Request Number</dt>
                    <dd class="col-sm-9"><strong>@Model.RequestNumber</strong></dd>

                    <dt class="col-sm-3">Requester</dt>
                    <dd class="col-sm-9">@Model.User.FirstName @Model.User.LastName (@Model.User.Email)</dd>

                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Category.CategoryName</dd>

                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location.Building!.BuildingName - Floor @Model.Location.Floor, Room @Model.Location.RoomNumber</dd>

                    <dt class="col-sm-3">Asset</dt>
                    <dd class="col-sm-9">
                        <form method="post" asp-action="SetAsset" asp-route-requestId="@Model.Id" class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <select name="assetId" class="form-select form-select-sm" style="max-width: 320px;" onchange="this.form.submit()">
                                <option value="">-- No asset linked --</option>
                                @foreach (var asset in (List<ZEGU.Core.Entities.Maintenance.Asset>)ViewBag.LocationAssets)
                                {
                                    <option value="@asset.Id" selected="@(Model.AssetId == asset.Id)">@asset.AssetName (@asset.AssetCode)</option>
                                }
                            </select>
                            @if (Model.Asset != null)
                            {
                                <a asp-area="Admin" asp-controller="Assets" asp-action="Details" asp-route-id="@Model.Asset.Id" class="btn btn-sm btn-outline-info" title="View asset">
                                    <i class="bi bi-box-seam"></i>
                                </a>
                            }
                        </form>
                    </dd>

                    <dt class="col-sm-3">Priority</dt>
                    <dd class="col-sm-9">
                        <span class="badge priority-@Model.Priority.ToString().ToLower()">@Model.Priority</span>
                    </dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    @if (!string.IsNullOrEmpty(Model.RejectionReason))
                    {
                        <dt class="col-sm-3">Rejection Reason</dt>
                        <dd class="col-sm-9 text-danger">@Model.RejectionReason</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <h5><i class="bi bi-chat"></i> Comments</h5>
            </div>
            <div class="card-body">
                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                {
                    <div class="border-bottom pb-2 mb-2">
                        <strong>@comment.User.FirstName @comment.User.LastName</strong>
                        @if (comment.IsInternal)
                        {
                            <span class="badge bg-warning text-dark ms-2">Internal</span>
                        }
                        <small class="text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        <p class="mb-0 mt-1">@comment.CommentText</p>
                    </div>
                }
                <form method="post" asp-action="AddComment" asp-route-requestId="@Model.Id" class="mt-3">
                    <div class="input-group">
                        <input type="text" name="commentText" class="form-control" placeholder="Reply to the requester..." required />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-reply"></i> Reply
                        </button>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="isInternal" name="isInternal" value="true" />
                        <input type="hidden" name="isInternal" value="false" />
                        <label class="form-check-label small text-muted" for="isInternal">
                            Internal note only (not visible or emailed to the requester)
                        </label>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (Model.Assignments.Any())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="bi bi-person-badge"></i> Assigned Technician</h5>
                </div>
                <div class="card-body">
                    @foreach (var assignment in Model.Assignments)
                    {
                        <p><strong>@assignment.Technician.TechnicianType</strong></p>
                        @if (!string.IsNullOrEmpty(assignment.Technician.User?.FirstName))
                        {
                            <p>@assignment.Technician.User.FirstName @assignment.Technician.User.LastName</p>
                        }
                        @if (!string.IsNullOrEmpty(assignment.Notes))
                        {
                            <p class="text-muted"><small>@assignment.Notes</small></p>
                        }
                    }
                </div>
            </div>
        }

        @if (Model.LaborCost.HasValue || Model.MaterialCost.HasValue || Model.OtherCost.HasValue)
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="bi bi-currency-dollar"></i> Cost Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Labor:</span>
                        <strong>@(Model.LaborCost?.ToString("C") ?? "$0.00")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Materials:</span>
                        <strong>@(Model.MaterialCost?.ToString("C") ?? "$0.00")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Other:</span>
                        <strong>@(Model.OtherCost?.ToString("C") ?? "$0.00")</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span>Total:</span>
                        <strong class="text-primary fs-5">@((Model.TotalCost ?? 0).ToString("C"))</strong>
                    </div>
                </div>
            </div>
        }

        @if (Model.MaterialRequests.Any())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="bi bi-box-seam"></i> Materials Requested</h5>
                </div>
                <div class="card-body">
                    @foreach (var mr in Model.MaterialRequests.OrderByDescending(m => m.CreatedAt))
                    {
                        var statusClass = mr.Status switch
                        {
                            ZEGU.Core.Enums.MaterialRequestStatus.Approved => "bg-success",
                            ZEGU.Core.Enums.MaterialRequestStatus.Rejected => "bg-danger",
                            _ => "bg-warning text-dark"
                        };
                        <div class="d-flex justify-content-between align-items-start mb-2 pb-2 border-bottom">
                            <div>
                                <strong>@mr.Material.MaterialName</strong> - @mr.QuantityRequested @mr.Material.Unit
                                @if (!string.IsNullOrEmpty(mr.Notes))
                                {
                                    <br /><small class="text-muted">@mr.Notes</small>
                                }
                            </div>
                            <span class="badge @statusClass">@mr.Status</span>
                        </div>
                    }
                    <a asp-controller="MaterialRequests" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-box-seam"></i> Review Material Requests
                    </a>
                </div>
            </div>
        }

        @if (Model.Attachments.Any() || !string.IsNullOrEmpty(Model.AfterPhotoPath))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="bi bi-images"></i> Attachments</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        @foreach (var attachment in Model.Attachments.Where(a => a.IsBeforePhoto))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    @if (attachment.FileType != null && attachment.FileType.StartsWith("image/"))
                                    {
                                        <img src="@attachment.FilePath" class="card-img-top" alt="Before photo" style="max-height: 200px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <a href="@attachment.FilePath" target="_blank" class="d-flex flex-column align-items-center justify-content-center py-4 text-decoration-none">
                                            <i class="bi bi-file-earmark-text" style="font-size: 2.5rem;"></i>
                                            <small class="text-truncate px-2">@attachment.FileName</small>
                                        </a>
                                    }
                                    <div class="card-body p-2">
                                        <small class="text-muted"><i class="bi bi-camera"></i> Before</small>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AfterPhotoPath))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <img src="@Model.AfterPhotoPath" class="card-img-top" alt="After photo" style="max-height: 200px; object-fit: cover;" />
                                    <div class="card-body p-2">
                                        <small class="text-muted"><i class="bi bi-camera-fill"></i> After</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-clock-history"></i> Status History</h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    @foreach (var history in Model.StatusHistory.OrderBy(h => h.CreatedAt))
                    {
                        <div class="timeline-item">
                            <div class="timeline-time">@history.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="timeline-content"><strong>@history.NewStatus</strong></div>
                            @if (!string.IsNullOrEmpty(history.Comments))
                            {
                                <div class="timeline-content text-muted small">@history.Comments</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
