@{
    ViewData["Title"] = "Add Material Usage";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-box"></i> Add Material Usage</h2>
        <p class="page-subtitle">Record materials used for work performed</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                @if (ViewBag.WorkLog != null)
                {
                    var workLog = (ZEGU.Core.Entities.Maintenance.WorkLog)ViewBag.WorkLog;
                    <div class="alert alert-info">
                        <strong>Work Log:</strong> @workLog.WorkPerformed<br />
                        <strong>Request:</strong> @workLog.Request.RequestNumber
                    </div>
                }

                <form method="post" asp-action="Create">
                    <input type="hidden" name="workLogId" value="@ViewBag.WorkLog.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label required-field">Material</label>
                        <select name="materialId" class="form-select" required>
                            <option value="">-- Select Material --</option>
                            @foreach (var material in ViewBag.Materials)
                            {
                                <option value="@material.Id">
                                    @material.MaterialName - Stock: @material.CurrentStock @material.Unit
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required-field">Quantity Used</label>
                        <input type="number" step="0.01" name="quantityUsed" class="form-control" required min="0.01" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Unit Cost (optional)</label>
                        <input type="number" step="0.01" name="unitCost" class="form-control" min="0" />
                        <small class="text-muted">Leave blank to use default material cost</small>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Details" asp-controller="Home" asp-route-id="@ViewBag.WorkLog.RequestId" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box"></i> Save Material Usage
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
