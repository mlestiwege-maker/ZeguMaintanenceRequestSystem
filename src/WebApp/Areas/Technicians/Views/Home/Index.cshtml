@model ZEGU.WebApp.ViewModels.Technicians.TechnicianDashboardViewModel
@{
    ViewData["Title"] = "My Work";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-tools"></i> My Work</h2>
        <p class="page-subtitle">Requests assigned to you</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-list-ul me-2"></i>Total Assigned</p>
                    <h3 class="stat-value mb-0">@Model.TotalAssigned</h3>
                </div>
                <i class="bi bi-list-ul stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-arrow-repeat me-2"></i>In Progress</p>
                    <h3 class="stat-value mb-0">@Model.InProgressCount</h3>
                </div>
                <i class="bi bi-arrow-repeat stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-check-circle me-2"></i>Completed This Month</p>
                    <h3 class="stat-value mb-0">@Model.CompletedThisMonth</h3>
                </div>
                <i class="bi bi-check-circle stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-danger text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-exclamation-triangle me-2"></i>Overdue</p>
                    <h3 class="stat-value mb-0">@Model.OverdueCount</h3>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5><i class="bi bi-clipboard-check"></i> Active Assignments</h5>
    </div>
    <div class="card-body">
        @if (Model.ActiveAssignments.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Title</th>
                            <th class="hide-mobile">Category</th>
                            <th class="hide-mobile">Location</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.ActiveAssignments)
                        {
                            var request = assignment.Request;
                            var isOverdue = request.Category.SLAHours.HasValue && DateTime.UtcNow > request.CreatedAt.AddHours(request.Category.SLAHours.Value);
                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td data-label="Request #"><strong>@request.RequestNumber</strong></td>
                                <td data-label="Title">@request.Title</td>
                                <td data-label="Category" class="hide-mobile">@request.Category.CategoryName</td>
                                <td data-label="Location" class="hide-mobile">@request.Location.Building!.BuildingName - @request.Location.RoomNumber</td>
                                <td data-label="Priority"><span class="badge priority-@request.Priority.ToString().ToLower()">@request.Priority</span></td>
                                <td data-label="Status">
                                    <span class="badge status-@request.Status.ToString().ToLower()">@request.Status</span>
                                    @if (isOverdue)
                                    {
                                        <br /><span class="badge bg-danger mt-1">Overdue</span>
                                    }
                                </td>
                                <td data-label="Action">
                                    <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-check2-circle"></i>
                <h4>No active assignments</h4>
                <p>You're all caught up. New assignments will show up here.</p>
            </div>
        }
    </div>
</div>

@if (Model.RecentlyCompleted.Any())
{
    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-clock-history"></i> Recently Completed</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Request #</th>
                            <th>Title</th>
                            <th>Completed</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.RecentlyCompleted)
                        {
                            var request = assignment.Request;
                            <tr>
                                <td data-label="Request #">@request.RequestNumber</td>
                                <td data-label="Title">@request.Title</td>
                                <td data-label="Completed">@(request.CompletedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td data-label="Action">
                                    <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
