@model ZEGU.Core.Entities.Maintenance.MaintenanceRequest
@{
    ViewData["Title"] = $"Request {Model.RequestNumber}";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-file-earmark-text"></i> Request @Model.RequestNumber</h2>
        <p class="page-subtitle">Assignment details</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <h5><i class="bi bi-info-circle"></i> Request Details</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Requester</dt>
                    <dd class="col-sm-9">@Model.User.FirstName @Model.User.LastName</dd>

                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Category.CategoryName</dd>

                    <dt class="col-sm-3">Location</dt>
                    <dd class="col-sm-9">@Model.Location.Building!.BuildingName - Floor @Model.Location.Floor, Room @Model.Location.RoomNumber</dd>

                    @if (Model.Asset != null)
                    {
                        <dt class="col-sm-3">Asset</dt>
                        <dd class="col-sm-9">@Model.Asset.AssetName (@Model.Asset.AssetCode)</dd>
                    }

                    <dt class="col-sm-3">Priority</dt>
                    <dd class="col-sm-9">
                        <span class="badge priority-@Model.Priority.ToString().ToLower()">@Model.Priority</span>
                    </dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge status-@Model.Status.ToString().ToLower()">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Submitted On</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Attachments.Any())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5><i class="bi bi-images"></i> Attachments</h5>
                </div>
                <div class="card-body">
                    @foreach (var attachment in Model.Attachments)
                    {
                        var isImage = attachment.FileType != null && attachment.FileType.StartsWith("image/");
                        <div class="mb-2">
                            <a href="@attachment.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="bi @(isImage ? "bi-image" : "bi-file-earmark-text")"></i> @attachment.FileName
                            </a>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">
                <h5><i class="bi bi-box-seam"></i> Materials Needed</h5>
            </div>
            <div class="card-body">
                @if (Model.MaterialRequests.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Material</th>
                                    <th>Qty</th>
                                    <th>Status</th>
                                    <th class="hide-mobile">Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mr in Model.MaterialRequests.OrderByDescending(m => m.CreatedAt))
                                {
                                    var statusClass = mr.Status switch
                                    {
                                        ZEGU.Core.Enums.MaterialRequestStatus.Approved => "bg-success",
                                        ZEGU.Core.Enums.MaterialRequestStatus.Rejected => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                    <tr>
                                        <td data-label="Material">@mr.Material.MaterialName</td>
                                        <td data-label="Qty">@mr.QuantityRequested @mr.Material.Unit</td>
                                        <td data-label="Status"><span class="badge @statusClass">@mr.Status</span></td>
                                        <td data-label="Notes" class="hide-mobile">
                                            @mr.Notes
                                            @if (!string.IsNullOrEmpty(mr.ReviewNotes))
                                            {
                                                <br /><small class="text-muted">Review: @mr.ReviewNotes</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No materials requested yet.</p>
                }

                <form method="post" asp-action="RequestMaterial" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="requestId" value="@Model.Id" />
                    <div class="col-md-5">
                        <label class="form-label small">Material</label>
                        <select name="materialId" class="form-select form-select-sm" asp-items="ViewBag.Materials" required>
                            <option value="">-- Select Material --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Quantity</label>
                        <input type="number" name="quantity" class="form-control form-control-sm" step="0.01" min="0.01" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Notes (optional)</label>
                        <input type="text" name="notes" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-plus-circle"></i> Request
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-chat"></i> Comments</h5>
            </div>
            <div class="card-body">
                @{
                    var visibleComments = Model.Comments.Where(c => !c.IsInternal).OrderBy(c => c.CreatedAt).ToList();
                }
                @if (visibleComments.Any())
                {
                    @foreach (var comment in visibleComments)
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <strong>@comment.User.FirstName @comment.User.LastName</strong>
                            <small class="text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            <p class="mb-0 mt-1">@comment.CommentText</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No comments yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (ViewBag.CanMarkComplete)
        {
            <div class="card mb-3 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check2-circle"></i> Mark as Complete</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Marking this complete does not close the request - a Works Officer or Manager will review your work and give the final approval.</p>
                    <form method="post" asp-action="MarkComplete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="requestId" value="@Model.Id" />
                        <div class="mb-2">
                            <label class="form-label small">Work Performed</label>
                            <textarea name="workPerformed" class="form-control form-control-sm" rows="3" placeholder="Describe what you did to fix this..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-success btn-sm w-100">
                            <i class="bi bi-check2-circle"></i> Mark Complete
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.StatusHistory.Any())
        {
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-clock-history"></i> History</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        @foreach (var history in Model.StatusHistory.OrderBy(h => h.CreatedAt))
                        {
                            <div class="timeline-item">
                                <div class="timeline-time">@history.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="timeline-content"><strong>@history.NewStatus</strong></div>
                                @if (!string.IsNullOrEmpty(history.Comments))
                                {
                                    <div class="timeline-content text-muted small">@history.Comments</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
