@model ZEGU.Core.Entities.Shared.MaintenanceCategory

@{
    ViewData["Title"] = "Edit Category";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-tag"></i> Edit Category</h2>
        <p class="page-subtitle">Update maintenance category details</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IsActive" />
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Icon (Bootstrap icon class)</label>
                        <input asp-for="Icon" class="form-control" placeholder="e.g. bi bi-lightning" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SLA Hours</label>
                        <input asp-for="SLAHours" type="number" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default Priority</label>
                        <select asp-for="DefaultPriority" class="form-select">
                            <option value="1">Low</option>
                            <option value="2">Normal</option>
                            <option value="3">High</option>
                            <option value="4">Emergency</option>
                        </select>
                        <small class="text-muted">Baseline priority assigned to new requests in this category. The system may escalate this automatically based on the request's description, but never lower it.</small>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
