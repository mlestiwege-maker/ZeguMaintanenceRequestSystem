@model ZEGU.Core.Entities.Shared.MaintenanceCategory

@{
    ViewData["Title"] = "Create Category";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-tags"></i> Create Category</h2>
        <p class="page-subtitle">Add a new maintenance request category</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label required-field">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SLA Hours</label>
                        <input asp-for="SLAHours" type="number" class="form-control" />
                        <small class="text-muted">Expected response time in hours</small>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-tag"></i> Create Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
