@model List<ZEGU.Core.Entities.Shared.MaintenanceCategory>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-tags"></i> Manage Categories</h2>
        <p class="page-subtitle">Create and manage maintenance categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Category
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-mobile-cards">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th class="hide-mobile">Description</th>
                        <th>SLA Hours</th>
                        <th>Default Priority</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td data-label="Category Name"><strong>@category.CategoryName</strong></td>
                            <td data-label="Description" class="hide-mobile">@category.Description</td>
                            <td data-label="SLA Hours">@category.SLAHours</td>
                            <td data-label="Default Priority">
                                <span class="badge priority-@category.DefaultPriority.ToString().ToLower()">@category.DefaultPriority</span>
                            </td>
                            <td data-label="Status">
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td data-label="Actions" class="table-actions">
                                <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-info" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@category.Id" style="display: inline;">
                                    <button type="submit" class="btn btn-sm @(category.IsActive ? "btn-danger" : "btn-success")" title="@(category.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(category.IsActive ? "x-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
