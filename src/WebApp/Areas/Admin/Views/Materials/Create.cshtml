@model ZEGU.Core.Entities.Maintenance.Material

@{
    ViewData["Title"] = "Create Material";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-box"></i> Create Material</h2>
        <p class="page-subtitle">Add a new material to the inventory</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label required-field">Material Name</label>
                        <input asp-for="MaterialName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input asp-for="Category" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Unit</label>
                            <input asp-for="Unit" class="form-control" placeholder="e.g. pieces, liters" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Unit Cost</label>
                            <input asp-for="UnitCost" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Supplier</label>
                        <input asp-for="Supplier" class="form-control" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Current Stock</label>
                            <input asp-for="CurrentStock" type="number" class="form-control" value="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Minimum Stock</label>
                            <input asp-for="MinimumStock" type="number" class="form-control" value="0" />
                        </div>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box"></i> Create Material
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
