@model List<ZEGU.Core.Entities.Maintenance.Material>

@{
    ViewData["Title"] = "Manage Materials";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-box"></i> Manage Materials</h2>
        <p class="page-subtitle">Create and manage maintenance materials and inventory</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Material
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-mobile-cards">
                <thead>
                    <tr>
                        <th>Material Name</th>
                        <th class="hide-mobile">Category</th>
                        <th class="hide-mobile">Unit</th>
                        <th class="hide-mobile">Unit Cost</th>
                        <th>Stock</th>
                        <th class="hide-mobile">Min Stock</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var material in Model)
                    {
                        <tr class="@(material.CurrentStock <= material.MinimumStock ? "table-warning" : "")">
                            <td data-label="Material Name"><strong>@material.MaterialName</strong></td>
                            <td data-label="Category" class="hide-mobile">@material.Category</td>
                            <td data-label="Unit" class="hide-mobile">@material.Unit</td>
                            <td data-label="Unit Cost" class="hide-mobile">@material.UnitCost?.ToString("C")</td>
                            <td data-label="Stock">
                                @material.CurrentStock
                                @if (material.CurrentStock <= material.MinimumStock)
                                {
                                    <span class="badge bg-danger ms-1">Low</span>
                                }
                            </td>
                            <td data-label="Min Stock" class="hide-mobile">@material.MinimumStock</td>
                            <td data-label="Status">
                                @if (material.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td data-label="Actions" class="table-actions">
                                <a asp-action="AdjustStock" asp-route-id="@material.Id" class="btn btn-sm btn-info" title="Adjust Stock">
                                    <i class="bi bi-box-seam"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@material.Id" style="display: inline;">
                                    <button type="submit" class="btn btn-sm @(material.IsActive ? "btn-danger" : "btn-success")" title="@(material.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(material.IsActive ? "x-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
