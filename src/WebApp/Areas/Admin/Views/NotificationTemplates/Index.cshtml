@model List<ZEGU.Core.Entities.Maintenance.NotificationTemplate>
@{
    ViewData["Title"] = "Notification Templates";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-envelope-paper"></i> Notification Templates</h2>
        <p class="page-subtitle">Manage email, SMS, and WhatsApp message templates</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Template
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th class="hide-mobile">Subject</th>
                            <th class="hide-mobile">Placeholders</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model)
                        {
                            <tr>
                                <td data-label="Name"><strong>@template.Name</strong></td>
                                <td data-label="Type">
                                    <span class="badge bg-info">@template.Type</span>
                                </td>
                                <td data-label="Subject" class="hide-mobile">@template.Subject</td>
                                <td data-label="Placeholders" class="hide-mobile">
                                    @foreach (var placeholder in template.Placeholders.Take(5))
                                    {
                                        <span class="badge bg-secondary me-1">@placeholder</span>
                                    }
                                    @if (template.Placeholders.Count > 5)
                                    {
                                        <span class="text-muted">+@(template.Placeholders.Count - 5) more</span>
                                    }
                                </td>
                                <td data-label="Actions">
                                    <div class="table-actions">
                                        <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-sm btn-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@template.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-envelope-paper"></i>
                <h4>No notification templates</h4>
                <p>Create your first notification template to get started.</p>
                <a asp-action="Create" class="btn btn-primary">Create Template</a>
            </div>
        }
    </div>
</div>
