@model ZEGU.Core.Entities.Maintenance.Asset
@{
    ViewData["Title"] = "Asset Details";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-box-seam"></i> @Model.AssetName</h2>
        <p class="page-subtitle">Asset details and maintenance history</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Asset Information
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="text-muted">Asset Code:</td>
                                <td><strong>@Model.AssetCode</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Serial Number:</td>
                                <td>@Model.SerialNumber</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Category:</td>
                                <td>@Model.Category?.CategoryName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Location:</td>
                                <td>@Model.Location?.RoomNumber (@Model.Location?.Building?.BuildingName)</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <td class="text-muted">Status:</td>
                                <td><span class="badge status-@Model.Status?.Replace(" ", "").ToLower()">@Model.Status</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Condition:</td>
                                <td>
                                    @{
                                        var conditionClass = Model.Condition switch
                                        {
                                            "Excellent" or "Good" => "bg-success",
                                            "Fair" => "bg-warning text-dark",
                                            "Poor" or "Critical" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Condition))
                                    {
                                        <span class="badge @conditionClass">@Model.Condition</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not set</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Manufacturer:</td>
                                <td>@Model.Manufacturer</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Model:</td>
                                <td>@Model.Model</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Warranty:</td>
                                <td>
                                    @if (Model.WarrantyExpiry.HasValue)
                                    {
                                        @if (Model.WarrantyExpiry.Value < DateTime.Now)
                                        {
                                            <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Expired (@Model.WarrantyExpiry.Value.ToString("dd MMM yyyy"))</span>
                                        }
                                        else
                                        {
                                            @Model.WarrantyExpiry.Value.ToString("dd MMM yyyy")
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not set</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Maintenance History
            </div>
            <div class="card-body">
                @if (Model.MaintenanceRequests != null && Model.MaintenanceRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.MaintenanceRequests.OrderByDescending(r => r.CreatedAt))
                                {
                                    <tr>
                                        <td data-label="Request #">@request.RequestNumber</td>
                                        <td data-label="Title">@request.Title</td>
                                        <td data-label="Status">
                                            <span class="badge status-@request.Status.ToString().ToLower()">@request.Status</span>
                                        </td>
                                        <td data-label="Date">@request.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td data-label="Action">
                                            <a asp-area="Works" asp-controller="Home" asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-clipboard-check"></i>
                        <h4>No maintenance history</h4>
                        <p>This asset has no maintenance requests yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (!string.IsNullOrEmpty(Model.QrCodePath))
        {
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-qr-code"></i> QR Code
                </div>
                <div class="card-body text-center">
                    <img src="@Model.QrCodePath" alt="QR Code" class="img-fluid mb-2" style="max-width: 200px;" />
                    <p class="text-muted small mb-2">Scan to view asset details on mobile</p>
                    <a asp-action="DownloadQrCode" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-download"></i> Download QR
                    </a>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-header">
                <i class="bi bi-graph-up"></i> Quick Stats
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total Requests:</span>
                    <strong>@Model.MaintenanceRequests?.Count</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Completed:</span>
                    <strong>@Model.MaintenanceRequests?.Count(r => r.Status == ZEGU.Core.Enums.MaintenanceRequestStatus.Completed)</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Last Maintenance:</span>
                    <strong>@(Model.MaintenanceRequests?.OrderByDescending(r => r.CreatedAt).FirstOrDefault()?.CreatedAt.ToString("dd MMM yyyy") ?? "Never")</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .status-operational { background-color: #198754; }
    .status-undermaintenance { background-color: #ffc107; color: #212529; }
    .status-outofservice { background-color: #dc3545; }
    .status-disposed { background-color: #6c757d; }
</style>
