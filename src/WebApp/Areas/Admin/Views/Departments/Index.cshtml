@model List<ZEGU.Core.Entities.Shared.Department>

@{
    ViewData["Title"] = "Manage Departments";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-building"></i> Manage Departments</h2>
        <p class="page-subtitle">Create and manage university departments</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Department
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-mobile-cards">
                <thead>
                    <tr>
                        <th>Department Name</th>
                        <th class="hide-mobile">Code</th>
                        <th class="hide-mobile">Head</th>
                        <th class="hide-mobile">Contact</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td data-label="Department Name"><strong>@dept.DepartmentName</strong></td>
                            <td data-label="Code" class="hide-mobile">@dept.Code</td>
                            <td data-label="Head" class="hide-mobile">@dept.HeadOfDepartment</td>
                            <td data-label="Contact" class="hide-mobile">@dept.ContactEmail</td>
                            <td data-label="Status">
                                @if (dept.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td data-label="Actions" class="table-actions">
                                <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-info" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@dept.Id" style="display: inline;">
                                    <button type="submit" class="btn btn-sm @(dept.IsActive ? "btn-danger" : "btn-success")" title="@(dept.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(dept.IsActive ? "x-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
