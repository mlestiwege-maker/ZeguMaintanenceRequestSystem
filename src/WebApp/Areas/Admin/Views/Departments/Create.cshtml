@model ZEGU.Core.Entities.Shared.Department

@{
    ViewData["Title"] = "Create Department";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-building"></i> Create Department</h2>
        <p class="page-subtitle">Add a new university department</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label required-field">Department Name</label>
                        <input asp-for="DepartmentName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input asp-for="Code" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Head of Department</label>
                        <input asp-for="HeadOfDepartment" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact Email</label>
                        <input asp-for="ContactEmail" type="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contact Phone</label>
                        <input asp-for="ContactPhone" class="form-control" />
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-building"></i> Create Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
