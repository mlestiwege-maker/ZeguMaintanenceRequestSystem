@model List<ZEGU.Core.Entities.Shared.Campus>

@{
    ViewData["Title"] = "Manage Campuses";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-geo-alt"></i> Manage Campuses</h2>
        <p class="page-subtitle">Create and manage university campuses</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Campus
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Campus Name</th>
                        <th>Code</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var campus in Model)
                    {
                        <tr>
                            <td><strong>@campus.CampusName</strong></td>
                            <td>@campus.Code</td>
                            <td>@campus.Address</td>
                            <td>
                                @if (campus.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@campus.Id" class="btn btn-sm btn-info" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@campus.Id" style="display: inline;">
                                    <button type="submit" class="btn btn-sm @(campus.IsActive ? "btn-danger" : "btn-success")" title="@(campus.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(campus.IsActive ? "x-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
