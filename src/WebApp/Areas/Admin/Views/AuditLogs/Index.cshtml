@model List<ZEGU.Core.Entities.Maintenance.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-shield-check"></i> Audit Logs</h2>
        <p class="page-subtitle">System activity tracking and compliance</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Date/Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity Type</th>
                            <th>Entity ID</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.CreatedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                                <td>@(log.UserName ?? "System")</td>
                                <td><span class="badge bg-info">@log.Action</span></td>
                                <td>@log.EntityType</td>
                                <td>@log.EntityId</td>
                                <td>@log.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-shield-check"></i>
                <h4>No audit logs</h4>
                <p>System activity will be logged here.</p>
            </div>
        }
    </div>
</div>
