@model ZEGU.WebApp.ViewModels.PagedResult<ZEGU.Core.Entities.Maintenance.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-shield-check"></i> Audit Logs</h2>
        <p class="page-subtitle">System activity tracking and compliance</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Date/Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th class="hide-mobile">Entity Type</th>
                            <th class="hide-mobile">Entity ID</th>
                            <th class="hide-mobile">IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Items)
                        {
                            <tr>
                                <td data-label="Date/Time">@log.CreatedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                                <td data-label="User">@(log.UserName ?? "System")</td>
                                <td data-label="Action"><span class="badge bg-info">@log.Action</span></td>
                                <td data-label="Entity Type" class="hide-mobile">@log.EntityType</td>
                                <td data-label="Entity ID" class="hide-mobile">@log.EntityId</td>
                                <td data-label="IP Address" class="hide-mobile">@log.IpAddress</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model)
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-shield-check"></i>
                <h4>No audit logs</h4>
                <p>System activity will be logged here.</p>
            </div>
        }
    </div>
</div>
