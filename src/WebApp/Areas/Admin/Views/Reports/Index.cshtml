@model ZEGU.WebApp.ViewModels.Admin.ReportsViewModel
@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-bar-chart"></i> Reports & Analytics</h2>
        <p class="page-subtitle">System reports and statistics</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")" class="btn btn-success">
            <i class="bi bi-download"></i> Export CSV
        </a>
    </div>
</div>

<div class="filter-bar">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel"></i> Apply Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-clockwise"></i> Reset
            </a>
        </div>
    </form>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-list-ul me-2"></i>Total Requests</p>
                    <h3 class="stat-value mb-0">@Model.TotalRequests</h3>
                </div>
                <i class="bi bi-list-ul stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-check-circle me-2"></i>Completed</p>
                    <h3 class="stat-value mb-0">@Model.CompletedRequests</h3>
                </div>
                <i class="bi bi-check-circle stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-currency-dollar me-2"></i>Total Cost</p>
                    <h3 class="stat-value mb-0">@Model.TotalCost?.ToString("C")</h3>
                </div>
                <i class="bi bi-currency-dollar stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-clock me-2"></i>Avg Resolution</p>
                    <h3 class="stat-value mb-0">@Model.AverageResolutionDays?.ToString("F1") days</h3>
                </div>
                <i class="bi bi-clock stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card stat-card @(Model.SlaCompliancePercentage is >= 90 ? "bg-success" : Model.SlaCompliancePercentage is >= 70 ? "bg-warning text-dark" : "bg-danger") text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-shield-check me-2"></i>SLA Compliance</p>
                    <h3 class="stat-value mb-0">@(Model.SlaCompliancePercentage.HasValue ? Model.SlaCompliancePercentage.Value.ToString("F1") + "%" : "N/A")</h3>
                </div>
                <i class="bi bi-shield-check stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-danger text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-exclamation-octagon me-2"></i>Currently Overdue</p>
                    <h3 class="stat-value mb-0">@Model.CurrentlyOverdueCount</h3>
                </div>
                <i class="bi bi-exclamation-octagon stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-secondary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-check2-square me-2"></i>SLA Met / Breached</p>
                    <h3 class="stat-value mb-0">@Model.SlaMetCount / @Model.SlaBreachedCount</h3>
                </div>
                <i class="bi bi-check2-square stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-graph-up"></i> Monthly Trends</h5>
            </div>
            <div class="card-body">
                @if (Model.MonthlyTrends.Any())
                {
                    <canvas id="monthlyTrendsChart" height="220"></canvas>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Month</th>
                                    <th>Requests</th>
                                    <th>Completed</th>
                                    <th>Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var month in Model.MonthlyTrends)
                                {
                                    <tr>
                                        <td data-label="Month">@month.Month</td>
                                        <td data-label="Requests">@month.RequestCount</td>
                                        <td data-label="Completed">@month.CompletedCount</td>
                                        <td data-label="Cost">@month.TotalCost?.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No data available for selected period.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-tags"></i> Requests by Category</h5>
            </div>
            <div class="card-body">
                @if (Model.RequestsByCategory.Any())
                {
                    <canvas id="categoryChart" height="220"></canvas>
                }
                @foreach (var item in Model.RequestsByCategory.OrderByDescending(x => x.Count))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 mt-3">
                        <span>@item.CategoryName</span>
                        <span>
                            <span class="badge bg-primary me-1">@item.Count</span>
                            <small class="text-muted">@item.TotalCost?.ToString("C")</small>
                        </span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar" role="progressbar" style="width: @(item.Count * 100 / Math.Max(1, Model.RequestsByCategory.Sum(x => x.Count)))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-shield-check"></i> SLA Compliance by Category</h5>
            </div>
            <div class="card-body">
                @if (Model.SlaByCategory.Any())
                {
                    <canvas id="slaChart" height="180"></canvas>
                }
                else
                {
                    <p class="text-muted">No SLA-eligible requests found for the selected period.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-building"></i> Requests by Department</h5>
            </div>
            <div class="card-body">
                @foreach (var item in Model.RequestsByDepartment.OrderByDescending(x => x.Count))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>@item.DepartmentName</span>
                        <span>
                            <span class="badge bg-secondary me-1">@item.Count</span>
                            <small class="text-muted">@item.TotalCost?.ToString("C")</small>
                        </span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-secondary" role="progressbar" style="width: @(item.Count * 100 / Math.Max(1, Model.RequestsByDepartment.Sum(x => x.Count)))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-geo-alt"></i> Requests by Location</h5>
            </div>
            <div class="card-body">
                @foreach (var item in Model.RequestsByLocation.OrderByDescending(x => x.Count))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>@item.BuildingName</span>
                        <span>
                            <span class="badge bg-success me-1">@item.Count</span>
                            <small class="text-muted">@item.TotalCost?.ToString("C")</small>
                        </span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(item.Count * 100 / Math.Max(1, Model.RequestsByLocation.Sum(x => x.Count)))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-arrow-repeat"></i> Requests by Status</h5>
            </div>
            <div class="card-body">
                @if (Model.RequestsByStatus.Any())
                {
                    <canvas id="statusChart" height="220"></canvas>
                }
                @foreach (var item in Model.RequestsByStatus.OrderByDescending(x => x.Count))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 mt-3">
                        <span>@item.Status</span>
                        <span class="badge bg-info">@item.Count</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-info" role="progressbar" style="width: @(item.Count * 100 / Math.Max(1, Model.RequestsByStatus.Sum(x => x.Count)))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-exclamation-triangle"></i> Requests by Priority</h5>
            </div>
            <div class="card-body">
                @if (Model.RequestsByPriority.Any())
                {
                    <canvas id="priorityChart" height="220"></canvas>
                }
                @foreach (var item in Model.RequestsByPriority.OrderByDescending(x => x.Count))
                {
                    <div class="d-flex justify-content-between align-items-center mb-2 mt-3">
                        <span>@item.Priority</span>
                        <span class="badge bg-warning text-dark">@item.Count</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(item.Count * 100 / Math.Max(1, Model.RequestsByPriority.Sum(x => x.Count)))%"></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-person-badge"></i> Technician Performance</h5>
            </div>
            <div class="card-body">
                @if (Model.TechnicianPerformance.Any(t => t.TotalAssignments > 0))
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Technician</th>
                                    <th class="hide-mobile">Type</th>
                                    <th>Assignments</th>
                                    <th class="hide-mobile">Work Logs</th>
                                    <th class="hide-mobile">Total Hours</th>
                                    <th class="hide-mobile">Labor Cost</th>
                                    <th>Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tech in Model.TechnicianPerformance.Where(t => t.TotalAssignments > 0).OrderByDescending(t => t.CompletedRequests))
                                {
                                    <tr>
                                        <td data-label="Technician"><strong>@tech.TechnicianName</strong></td>
                                        <td data-label="Type" class="hide-mobile">@tech.TechnicianType</td>
                                        <td data-label="Assignments"><span class="badge bg-primary">@tech.TotalAssignments</span></td>
                                        <td data-label="Work Logs" class="hide-mobile"><span class="badge bg-info">@tech.TotalWorkLogs</span></td>
                                        <td data-label="Total Hours" class="hide-mobile">@(tech.TotalHours.HasValue ? tech.TotalHours.Value.ToString("F1") : "0")</td>
                                        <td data-label="Labor Cost" class="hide-mobile">@tech.TotalLaborCost?.ToString("C")</td>
                                        <td data-label="Completed"><span class="badge bg-success">@tech.CompletedRequests</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-bar-chart"></i>
                        <h4>No data available</h4>
                        <p>There is no technician performance data available for the selected period.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
    <script>
        const chartTextColor = getComputedStyle(document.body).color || '#333';
        Chart.defaults.color = chartTextColor;

        @if (Model.MonthlyTrends.Any())
        {
            <text>
        new Chart(document.getElementById('monthlyTrendsChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(m => m.Month))),
                datasets: [
                    {
                        label: 'Submitted',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(m => m.RequestCount))),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13,110,253,0.15)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Completed',
                        data: @Html.Raw(Json.Serialize(Model.MonthlyTrends.Select(m => m.CompletedCount))),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25,135,84,0.15)',
                        tension: 0.3,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
            </text>
        }

        @if (Model.RequestsByCategory.Any())
        {
            <text>
        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RequestsByCategory.OrderByDescending(c => c.Count).Select(c => c.CategoryName))),
                datasets: [{
                    label: 'Requests',
                    data: @Html.Raw(Json.Serialize(Model.RequestsByCategory.OrderByDescending(c => c.Count).Select(c => c.Count))),
                    backgroundColor: '#0d6efd'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
            </text>
        }

        @if (Model.RequestsByStatus.Any())
        {
            <text>
        new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RequestsByStatus.Select(s => s.Status))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.RequestsByStatus.Select(s => s.Count))),
                    backgroundColor: ['#0d6efd', '#6c757d', '#0dcaf0', '#ffc107', '#198754', '#dc3545', '#6f42c1', '#fd7e14']
                }]
            },
            options: { responsive: true }
        });
            </text>
        }

        @if (Model.RequestsByPriority.Any())
        {
            <text>
        new Chart(document.getElementById('priorityChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RequestsByPriority.Select(p => p.Priority))),
                datasets: [{
                    label: 'Requests',
                    data: @Html.Raw(Json.Serialize(Model.RequestsByPriority.Select(p => p.Count))),
                    backgroundColor: '#ffc107'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
            </text>
        }

        @if (Model.SlaByCategory.Any())
        {
            <text>
        new Chart(document.getElementById('slaChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SlaByCategory.Select(s => s.CategoryName))),
                datasets: [
                    {
                        label: 'Met SLA',
                        data: @Html.Raw(Json.Serialize(Model.SlaByCategory.Select(s => s.MetCount))),
                        backgroundColor: '#198754'
                    },
                    {
                        label: 'Breached SLA',
                        data: @Html.Raw(Json.Serialize(Model.SlaByCategory.Select(s => s.BreachedCount))),
                        backgroundColor: '#dc3545'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
            </text>
        }
    </script>
}
