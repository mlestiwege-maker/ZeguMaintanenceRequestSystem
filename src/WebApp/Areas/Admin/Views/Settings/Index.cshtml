@model ZEGU.WebApp.ViewModels.Admin.SystemSettingsViewModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-gear"></i> System Settings</h2>
        <p class="page-subtitle">Configure system parameters and view statistics</p>
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bar-chart"></i> System Stats
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Users:</span>
                    <strong>@Model.TotalUsers</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Requests:</span>
                    <strong>@Model.TotalRequests</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Categories:</span>
                    <strong>@Model.TotalCategories</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Technicians:</span>
                    <strong>@Model.TotalTechnicians</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Assets:</span>
                    <strong>@Model.TotalAssets</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>PM Schedules:</span>
                    <strong>@Model.TotalSchedules</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>Unread Notifications:</span>
                    <strong class="text-danger">@Model.UnreadNotifications</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-clock"></i> SLA Settings
            </div>
            <div class="card-body">
                <form asp-action="UpdateSlaSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Emergency (hours)</label>
                            <input type="number" name="emergency" class="form-control" value="@Model.SLAEmergency" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">High (hours)</label>
                            <input type="number" name="high" class="form-control" value="@Model.SLAHigh" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Normal (hours)</label>
                            <input type="number" name="normal" class="form-control" value="@Model.SLANormal" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Low (hours)</label>
                            <input type="number" name="low" class="form-control" value="@Model.SLALow" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Save SLA Settings
                    </button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-cloud"></i> System Configuration
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Application URL</label>
                        <input type="text" class="form-control" value="@Model.AppUrl" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">QR Code API URL</label>
                        <input type="text" class="form-control" value="@Model.QrCodeApiUrl" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Max File Size (MB)</label>
                        <input type="text" class="form-control" value="@Model.MaxFileSize" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Admin Email</label>
                        <input type="text" class="form-control" value="@Model.AdminEmail" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-shield-check"></i> System Information
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted">Environment:</td>
                        <td><span class="badge bg-info">@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">.NET Version:</td>
                        <td>@Environment.Version.ToString()</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Server Time:</td>
                        <td>@DateTime.UtcNow.ToString("dd MMM yyyy HH:mm:ss") UTC</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Database:</td>
                        <td>PostgreSQL</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
