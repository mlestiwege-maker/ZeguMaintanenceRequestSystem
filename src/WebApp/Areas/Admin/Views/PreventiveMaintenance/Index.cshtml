@model List<ZEGU.Core.Entities.Maintenance.PreventiveMaintenanceSchedule>
@{
    ViewData["Title"] = "Preventive Maintenance";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-calendar-check"></i> Preventive Maintenance</h2>
        <p class="page-subtitle">Manage scheduled maintenance activities</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="CheckDueNow" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-bell"></i> Check Due Schedules Now
            </button>
        </form>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Schedule
        </a>
    </div>
</div>

@{
    var inProgressCount = Model.Count(s => s.Status == ZEGU.Core.Enums.PreventiveMaintenanceStatus.InProgress);
    var overdueCount = Model.Count(s => s.NextDue < DateTime.UtcNow);
}
<div class="row mb-3">
    <div class="col-md-4">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-arrow-repeat me-2"></i>Currently Under Service</p>
                    <h3 class="stat-value mb-0">@inProgressCount</h3>
                </div>
                <i class="bi bi-arrow-repeat stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-danger text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-exclamation-triangle me-2"></i>Overdue</p>
                    <h3 class="stat-value mb-0">@overdueCount</h3>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card bg-secondary text-white">
            <div class="card-body">
                <div>
                    <p class="stat-label mb-1"><i class="bi bi-list-ul me-2"></i>Total Schedules</p>
                    <h3 class="stat-value mb-0">@Model.Count</h3>
                </div>
                <i class="bi bi-list-ul stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover table-mobile-cards">
                    <thead>
                        <tr>
                            <th>Schedule</th>
                            <th class="hide-mobile">Asset</th>
                            <th class="hide-mobile">Category</th>
                            <th class="hide-mobile">Location</th>
                            <th class="hide-mobile">Frequency</th>
                            <th>Next Due</th>
                            <th>Progress</th>
                            <th>Active</th>
                            <th class="hide-mobile">Assigned</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model)
                        {
                            var isOverdue = schedule.NextDue < DateTime.UtcNow;
                            var isDueSoon = schedule.NextDue < DateTime.UtcNow.AddDays(7);
                            var isInProgress = schedule.Status == ZEGU.Core.Enums.PreventiveMaintenanceStatus.InProgress;
                            <tr class="@(isInProgress ? "table-primary" : isOverdue ? "table-danger" : (isDueSoon ? "table-warning" : ""))">
                                <td data-label="Schedule">
                                    <strong>@schedule.ScheduleName</strong>
                                    @if (!string.IsNullOrEmpty(schedule.Description))
                                    {
                                        <br /><small class="text-muted">@schedule.Description</small>
                                    }
                                </td>
                                <td data-label="Asset" class="hide-mobile">@(schedule.Asset?.AssetName ?? "-")</td>
                                <td data-label="Category" class="hide-mobile">@schedule.Category?.CategoryName</td>
                                <td data-label="Location" class="hide-mobile">@schedule.Location?.RoomNumber (@schedule.Location?.Building?.BuildingName)</td>
                                <td data-label="Frequency" class="hide-mobile"><span class="badge bg-info">@schedule.Frequency</span></td>
                                <td data-label="Next Due">
                                    <strong>@schedule.NextDue.ToString("dd MMM yyyy")</strong>
                                    @if (isOverdue)
                                    {
                                        <br /><span class="badge bg-danger">Overdue</span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <br /><span class="badge bg-warning text-dark">Due Soon</span>
                                    }
                                </td>
                                <td data-label="Progress">
                                    @if (isInProgress)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-arrow-repeat"></i> In Progress</span>
                                        @if (schedule.StartedAt.HasValue)
                                        {
                                            <br /><small class="text-muted">Since @schedule.StartedAt.Value.ToString("dd MMM HH:mm")</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Scheduled</span>
                                    }
                                </td>
                                <td data-label="Active">
                                    @if (schedule.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td data-label="Assigned" class="hide-mobile">@(schedule.Technician?.User?.FirstName + " " + schedule.Technician?.User?.LastName ?? "Unassigned")</td>
                                <td data-label="Actions">
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@schedule.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@schedule.Id" class="btn btn-sm btn-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@schedule.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(schedule.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(schedule.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(schedule.IsActive ? "bi-pause" : "bi-play")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-check"></i>
                <h4>No preventive maintenance schedules</h4>
                <p>Get started by creating your first preventive maintenance schedule.</p>
                <a asp-action="Create" class="btn btn-primary">Create Schedule</a>
            </div>
        }
    </div>
</div>
