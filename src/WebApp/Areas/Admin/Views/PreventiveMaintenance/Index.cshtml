@model List<ZEGU.Core.Entities.Maintenance.PreventiveMaintenanceSchedule>
@{
    ViewData["Title"] = "Preventive Maintenance";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-calendar-check"></i> Preventive Maintenance</h2>
        <p class="page-subtitle">Manage scheduled maintenance activities</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New Schedule
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Schedule</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Frequency</th>
                            <th>Next Due</th>
                            <th>Status</th>
                            <th>Assigned</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in Model)
                        {
                            var isOverdue = schedule.NextDue < DateTime.UtcNow;
                            var isDueSoon = schedule.NextDue < DateTime.UtcNow.AddDays(7);
                            <tr class="@(isOverdue ? "table-danger" : (isDueSoon ? "table-warning" : ""))">
                                <td>
                                    <strong>@schedule.ScheduleName</strong>
                                    @if (!string.IsNullOrEmpty(schedule.Description))
                                    {
                                        <br /><small class="text-muted">@schedule.Description</small>
                                    }
                                </td>
                                <td>@schedule.Category?.CategoryName</td>
                                <td>@schedule.Location?.RoomNumber (@schedule.Location?.Building?.BuildingName)</td>
                                <td><span class="badge bg-info">@schedule.Frequency</span></td>
                                <td>
                                    <strong>@schedule.NextDue.ToString("dd MMM yyyy")</strong>
                                    @if (isOverdue)
                                    {
                                        <br /><span class="badge bg-danger">Overdue</span>
                                    }
                                    else if (isDueSoon)
                                    {
                                        <br /><span class="badge bg-warning text-dark">Due Soon</span>
                                    }
                                </td>
                                <td>
                                    @if (schedule.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@(schedule.Technician?.User?.FirstName + " " + schedule.Technician?.User?.LastName ?? "Unassigned")</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@schedule.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@schedule.Id" class="btn btn-sm btn-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@schedule.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(schedule.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(schedule.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(schedule.IsActive ? "bi-pause" : "bi-play")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-calendar-check"></i>
                <h4>No preventive maintenance schedules</h4>
                <p>Get started by creating your first preventive maintenance schedule.</p>
                <a asp-action="Create" class="btn btn-primary">Create Schedule</a>
            </div>
        }
    </div>
</div>
