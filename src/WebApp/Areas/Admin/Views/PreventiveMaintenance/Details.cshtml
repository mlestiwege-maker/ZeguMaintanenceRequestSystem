@model ZEGU.Core.Entities.Maintenance.PreventiveMaintenanceSchedule
@{
    ViewData["Title"] = Model.ScheduleName;
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-calendar-check"></i> @Model.ScheduleName</h2>
        <p class="page-subtitle">Preventive maintenance schedule details</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == ZEGU.Core.Enums.PreventiveMaintenanceStatus.InProgress)
        {
            <span class="badge bg-primary fs-6 align-self-center"><i class="bi bi-arrow-repeat"></i> In Progress</span>
        }
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> Schedule Information
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted" style="width: 30%;">Category:</td>
                        <td><strong>@Model.Category?.CategoryName</strong></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Location:</td>
                        <td>@Model.Location?.RoomNumber (@Model.Location?.Building?.BuildingName)</td>
                    </tr>
                    @if (Model.Asset != null)
                    {
                        <tr>
                            <td class="text-muted">Asset:</td>
                            <td><a asp-area="Admin" asp-controller="Assets" asp-action="Details" asp-route-id="@Model.Asset.Id">@Model.Asset.AssetName (@Model.Asset.AssetCode)</a></td>
                        </tr>
                    }
                    <tr>
                        <td class="text-muted">Progress:</td>
                        <td>
                            @if (Model.Status == ZEGU.Core.Enums.PreventiveMaintenanceStatus.InProgress)
                            {
                                <span class="badge bg-primary"><i class="bi bi-arrow-repeat"></i> In Progress</span>
                                @if (Model.StartedAt.HasValue)
                                {
                                    <span class="text-muted ms-2">
                                        Started @Model.StartedAt.Value.ToString("dd MMM yyyy HH:mm")
                                        @if (Model.StartedBy != null)
                                        {
                                            <text> by @Model.StartedBy.FirstName @Model.StartedBy.LastName</text>
                                        }
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">Scheduled</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Frequency:</td>
                        <td><span class="badge bg-info">@Model.Frequency</span> (every @Model.FrequencyDays days)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Last Performed:</td>
                        <td>@(Model.LastPerformed?.ToString("dd MMM yyyy") ?? "Never")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Next Due:</td>
                        <td>
                            <strong>@Model.NextDue.ToString("dd MMM yyyy")</strong>
                            @if (Model.NextDue < DateTime.UtcNow)
                            {
                                <span class="badge bg-danger ms-2">Overdue</span>
                            }
                            else if (Model.NextDue < DateTime.UtcNow.AddDays(7))
                            {
                                <span class="badge bg-warning text-dark ms-2">Due Soon</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Assigned Technician:</td>
                        <td>@(Model.Technician?.User?.FirstName + " " + Model.Technician?.User?.LastName ?? "Unassigned")</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <tr>
                            <td class="text-muted">Description:</td>
                            <td>@Model.Description</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-clock-history"></i> Maintenance History
            </div>
            <div class="card-body">
                @if (Model.Records != null && Model.Records.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-mobile-cards">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Performed By</th>
                                    <th>Work Done</th>
                                    <th class="hide-mobile">Duration</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.Records.OrderByDescending(r => r.PerformedAt))
                                {
                                    <tr>
                                        <td data-label="Date">@record.PerformedAt.ToString("dd MMM yyyy")</td>
                                        <td data-label="Performed By">@(record.PerformedBy?.FirstName + " " + record.PerformedBy?.LastName ?? "N/A")</td>
                                        <td data-label="Work Done">@record.WorkPerformed</td>
                                        <td data-label="Duration" class="hide-mobile">
                                            @if (record.StartedAt.HasValue)
                                            {
                                                var duration = record.PerformedAt - record.StartedAt.Value;
                                                @($"{(int)duration.TotalHours}h {duration.Minutes}m")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td data-label="Notes">@record.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No maintenance records yet.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (Model.Status == ZEGU.Core.Enums.PreventiveMaintenanceStatus.Scheduled)
        {
            <div class="card mb-3 border-primary">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-play-circle"></i> Start Service
                </div>
                <div class="card-body">
                    <p class="text-muted small">Mark this service as started so its progress can be tracked while work is underway.</p>
                    <form asp-action="StartService" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-play-circle"></i> Start Service
                        </button>
                    </form>
                </div>
            </div>
        }
        <div class="card">
            <div class="card-header">
                <i class="bi bi-check-circle"></i> Mark as Performed
            </div>
            <div class="card-body">
                <form asp-action="MarkPerformed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="scheduleId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Work Performed *</label>
                        <textarea name="workPerformed" class="form-control" rows="4" required placeholder="Describe what was done..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Any additional notes..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-check-lg"></i> Mark Complete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
