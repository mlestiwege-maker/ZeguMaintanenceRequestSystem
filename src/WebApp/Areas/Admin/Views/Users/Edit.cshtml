@model ZEGU.Core.Entities.Identity.ApplicationUser

@{
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-pencil"></i> Edit User</h2>
        <p class="page-subtitle">Update user information and permissions</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <form method="post" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" name="lastName" class="form-control" value="@Model.LastName" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="@Model.Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select" required>
                            @foreach (var role in Enum.GetValues(typeof(ZEGU.Core.Enums.UserRole)).Cast<ZEGU.Core.Enums.UserRole>())
                            {
                                <option value="@((int)role)" selected="@(Model.Role == role ? "selected" : null)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Department</label>
                        <select name="departmentId" class="form-select">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in ViewBag.Departments as List<ZEGU.Core.Entities.Shared.Department>)
                            {
                                <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id ? "selected" : null)">@dept.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student/Staff Number</label>
                        <input type="text" name="studentNumber" class="form-control" value="@Model.StudentNumber" />
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
