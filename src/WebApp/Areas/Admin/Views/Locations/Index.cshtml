@model List<ZEGU.Core.Entities.Shared.Building>

@{
    ViewData["Title"] = "Manage Locations";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-geo-alt"></i> Manage Locations</h2>
        <p class="page-submary">Manage buildings and rooms across campuses</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Building
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Building</th>
                        <th>Code</th>
                        <th>Campus</th>
                        <th>Floors</th>
                        <th>Rooms</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var building in Model)
                    {
                        <tr>
                            <td><strong>@building.BuildingName</strong></td>
                            <td>@building.Code</td>
                            <td>@building.Campus?.CampusName</td>
                            <td>@building.Floors</td>
                            <td>@building.Rooms.Count</td>
                            <td>
                                @if (building.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="table-actions">
                                <a asp-action="Edit" asp-route-id="@building.Id" class="btn btn-sm btn-info" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Rooms" asp-route-buildingId="@building.Id" class="btn btn-sm btn-secondary" title="Manage Rooms">
                                    <i class="bi bi-door-open"></i>
                                </a>
                                <form method="post" asp-action="ToggleActive" asp-route-id="@building.Id" style="display: inline;">
                                    <button type="submit" class="btn btn-sm @(building.IsActive ? "btn-danger" : "btn-success")" title="@(building.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(building.IsActive ? "x-circle" : "check-circle")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
