@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-shield-check"></i> Privacy Policy</h2>
        <p class="page-subtitle">How we protect your data</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <h4>Data Collection</h4>
                <p>We collect only the information necessary to provide maintenance services to the ZEGU University community.</p>
                
                <h4 class="mt-4">Data Usage</h4>
                <p>Your data is used solely for managing maintenance requests, assigning technicians, and improving service delivery.</p>
                
                <h4 class="mt-4">Data Protection</h4>
                <p>We implement appropriate security measures to protect your personal information from unauthorized access or disclosure.</p>
                
                <h4 class="mt-4">Contact</h4>
                <p>For privacy concerns, please contact the ZEGU IT Department.</p>
            </div>
        </div>
    </div>
</div>
