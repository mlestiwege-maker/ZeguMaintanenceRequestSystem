@{
    ViewData["Title"] = "Home";
}

<div class="card hero-card mb-4">
    <div class="card-body text-center text-lg-start">
        <div class="hero-eyebrow mb-3">
            <i class="bi bi-phone"></i>
            Mobile-first campus maintenance
        </div>
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <i class="bi bi-tools d-inline-flex align-items-center justify-content-center mb-3" style="font-size: 3rem;"></i>
                <h1 class="fw-bold">Welcome to ZEGU Maintenance</h1>
                <p class="lead mb-4">Submit, track, and manage campus maintenance requests from any device with a cleaner, faster experience built for mobile.</p>
                <div class="hero-actions justify-content-center justify-content-lg-start">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Student") || User.IsInRole("Staff"))
                        {
                            <a asp-area="Requests" asp-controller="Home" asp-action="Create" class="btn btn-light btn-lg">
                                <i class="bi bi-plus-circle"></i> New Request
                            </a>
                        }
                        <a asp-area="" asp-controller="Account" asp-action="Profile" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-person-circle"></i> My Profile
                        </a>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </a>
                        <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="feature-grid">
                    <div class="card feature-card text-start">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-speedometer2 me-2"></i>Fast access</h5>
                            <p class="mb-0 opacity-75">Big touch targets, compact navigation, and key actions surfaced first.</p>
                        </div>
                    </div>
                    <div class="card feature-card text-start">
                        <div class="card-body">
                            <h5 class="card-title"><i class="bi bi-shield-check me-2"></i>Better clarity</h5>
                            <p class="mb-0 opacity-75">Simplified layout makes requests, updates, and status checks easier on small screens.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row row-cols-1 row-cols-md-3 g-3 dashboard-section">
        <div class="col">
            <div class="card stat-card bg-primary text-white h-100">
                <div class="card-body">
                    <div>
                        <h5 class="card-title"><i class="bi bi-speedometer2"></i> Quick Actions</h5>
                        <p class="card-text small opacity-75">Access your most used features</p>
                    </div>
                    <div class="mt-3 d-grid gap-2">
                        @if (User.IsInRole("Student") || User.IsInRole("Staff"))
                        {
                            <a asp-area="Requests" asp-controller="Home" asp-action="Create" class="btn btn-light btn-sm text-start">
                                <i class="bi bi-plus-circle me-2"></i> Submit a Request
                            </a>
                            <a asp-area="Requests" asp-controller="Home" asp-action="MyRequests" class="btn btn-light btn-sm text-start">
                                <i class="bi bi-list-check me-2"></i> View My Requests
                            </a>
                        }
                        <a asp-area="" asp-controller="Account" asp-action="Profile" class="btn btn-light btn-sm text-start">
                            <i class="bi bi-person me-2"></i> Update Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card bg-success text-white h-100">
                <div class="card-body">
                    <div>
                        <h5 class="card-title"><i class="bi bi-info-circle"></i> How It Works</h5>
                        <p class="card-text small opacity-75">Simple 3-step process</p>
                    </div>
                    <div class="mt-3">
                        <div class="d-flex align-items-start mb-2">
                            <span class="badge bg-light text-primary me-2">1</span>
                            <small>Submit a maintenance request with details</small>
                        </div>
                        <div class="d-flex align-items-start mb-2">
                            <span class="badge bg-light text-primary me-2">2</span>
                            <small>Works team reviews and assigns a technician</small>
                        </div>
                        <div class="d-flex align-items-start">
                            <span class="badge bg-light text-primary me-2">3</span>
                            <small>Track progress until completion</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card bg-info text-white h-100">
                <div class="card-body">
                    <div>
                        <h5 class="card-title"><i class="bi bi-telephone"></i> Need Help?</h5>
                        <p class="card-text small opacity-75">Contact the Works Department</p>
                    </div>
                    <div class="mt-3">
                        <p class="mb-1"><i class="bi bi-envelope me-2"></i>works@zegu.edu</p>
                        <p class="mb-1"><i class="bi bi-telephone me-2"></i>+255 123 456 789</p>
                        <p class="mb-0"><i class="bi bi-geo-alt me-2"></i>Works Department, Main Campus</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
