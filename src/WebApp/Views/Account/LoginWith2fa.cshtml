@{
    ViewData["Title"] = "Two-Factor Authentication";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var rememberMe = ViewData["RememberMe"] as bool? ?? false;
}

<div class="auth-page">
    <div class="auth-card fade-in">
        <div class="card-header">
            <i class="bi bi-shield-lock"></i>
            <h3 class="mb-0">Two-Factor Authentication</h3>
            <p class="mb-0 opacity-75">Enter the code from your authenticator app</p>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <form method="post" asp-action="LoginWith2fa">
                <input type="hidden" name="rememberMe" value="@rememberMe" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <div class="mb-3">
                    <label class="form-label">Authenticator Code</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input type="text" name="code" class="form-control" placeholder="123456" autocomplete="one-time-code" required autofocus />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right"></i> Verify
                </button>
            </form>
            <div class="text-center mt-4">
                <p class="text-muted">
                    Don't have access to your device?
                    <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@returnUrl" class="text-decoration-none fw-semibold">Use a recovery code</a>
                </p>
            </div>
        </div>
    </div>
</div>
