@model string[]

@{
    ViewData["Title"] = "Recovery Codes";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-key"></i> Your Recovery Codes</h2>
        <p class="page-subtitle">Store these somewhere safe — they won't be shown again</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Put these codes in a safe place. If you lose your device and don't have the recovery codes,
                    you will lose access to your account.
                </div>

                <div class="row">
                    @foreach (var code in Model)
                    {
                        <div class="col-md-6">
                            <code class="d-block mb-2 p-2 bg-light rounded">@code</code>
                        </div>
                    }
                </div>

                <a asp-action="TwoFactorAuthentication" class="btn btn-primary mt-3">
                    <i class="bi bi-arrow-left"></i> Done
                </a>
            </div>
        </div>
    </div>
</div>
