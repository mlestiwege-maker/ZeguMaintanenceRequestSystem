@model ZEGU.Core.Entities.Identity.ApplicationUser

@{
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-person-circle"></i> My Profile</h2>
        <p class="page-subtitle">View and manage your account details</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="EditProfile" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit Profile
        </a>
        <a asp-action="ChangePassword" class="btn btn-warning">
            <i class="bi bi-key"></i> Change Password
        </a>
        <a asp-action="TwoFactorAuthentication" class="btn btn-outline-primary">
            <i class="bi bi-shield-lock"></i> Two-Factor Authentication
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

                    <dt class="col-sm-3">Username</dt>
                    <dd class="col-sm-9">@Model.UserName</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Email</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</dd>

                    <dt class="col-sm-3">Role</dt>
                    <dd class="col-sm-9">@Model.Role</dd>

                    @if (!string.IsNullOrEmpty(Model.StudentNumber))
                    {
                        <dt class="col-sm-3">Student Number</dt>
                        <dd class="col-sm-9">@Model.StudentNumber</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.StaffNumber))
                    {
                        <dt class="col-sm-3">Staff Number</dt>
                        <dd class="col-sm-9">@Model.StaffNumber</dd>
                    }

                    <dt class="col-sm-3">Account Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>

                    <dt class="col-sm-3">Member Since</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
