@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="auth-page">
    <div class="auth-card fade-in">
        <div class="card-header bg-danger">
            <i class="bi bi-exclamation-triangle"></i>
            <h3 class="mb-0">Something went wrong</h3>
            <p class="mb-0 opacity-75">We encountered an unexpected error</p>
        </div>
        <div class="card-body text-center">
            <div class="empty-state">
                <i class="bi bi-bug"></i>
                <h4>Oops! Error occurred</h4>
                <p>An error occurred while processing your request. Please try again later.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
                }
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house"></i> Go Home
                </a>
            </div>
        </div>
    </div>
</div>
